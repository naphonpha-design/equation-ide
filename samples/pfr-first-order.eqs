// Isothermal plug-flow reactor, first-order A -> B
// V is the independent variable: reactor volume
// Analytic solution: FA = FA0*exp(-k*V/v0)

//1. Design equations
FA'=-rA;    FA#FA0
FB'=rA;     FB#0

//2. Feed and kinetics
FA0=5           //mol/s
v0=0.5          //m3/s
k=0.8           //1/s

//3. Rate law
CA=FA/v0
rA=k*CA

//4. Conversion
XA=(FA0-FA)/FA0

//5. Integration and reporting
INTEGRAL V[0,2] step 0.05 by RKV
trend CA,FA,FB,XA step 0.25
OUTPUT FA,FB,CA,XA
